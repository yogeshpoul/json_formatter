{
  "name": "private-json-formatter",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first, browser-based JSON formatter, validator and developer toolkit. All processing happens locally in the browser.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-ads-txt.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-segment-files.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
