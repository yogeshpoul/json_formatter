# All variables are OPTIONAL. The site builds and works without any of them.

# Canonical site URL used for metadata, sitemap and structured data.
# Falls back to Vercel's production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public contact email shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense (leave empty until your site is approved).
# Publisher ID format: ca-pub-XXXXXXXXXXXXXXXX (16 digits)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ad unit slot IDs (numeric) from AdSense > Ads > By ad unit
NEXT_PUBLIC_ADSENSE_SLOT_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Google Search Console HTML-tag verification code (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
